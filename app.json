{
  "expo": {
    "name": "RFV",
    "slug": "App",
    "version": "4.0.0",
    "runtimeVersion": "4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.teamrotor.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.teamrotor.app",
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RFV to use the camera to scan QR asset tags.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3723ae93-3dfe-4f79-980c-b3754e4168ee"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/3723ae93-3dfe-4f79-980c-b3754e4168ee",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    }
  }
}
